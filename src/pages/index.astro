---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { SITE } from '../data/site';
import services from '../data/services.json';
import hoods from '../data/neighborhoods.json';

const name = (h1: string) => h1.replace(/ in Bakersfield$/, '');
const featured = services.slice(0, 6);
const faq = [
  { q: 'How much does junk removal cost in Bakersfield?', a: 'Pricing is based on how much truck space your items take up. Text us photos for a fast, no-obligation estimate — we usually reply within minutes.' },
  { q: 'Do you offer same-day junk removal?', a: 'Yes, when the route allows. Call or text (661) 996-6950 and we will tell you the earliest window.' },
  { q: 'Are you licensed and insured?', a: 'Yes. T&M Hauling is a licensed and insured father–son crew serving Bakersfield and Kern County.' },
  { q: 'Do you clean up after the haul?', a: 'Always. Every job ends with a broom-swept floor — leave the floor swept, every time.' },
];
const schema = [
  { '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: SITE.url, name: SITE.name, publisher: { '@id': `${SITE.url}/#organization` }, inLanguage: 'en-US' },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base
  title="Bakersfield Junk Removal | Same-Day Hauling | T&M Hauling"
  description="Father–son junk removal in Bakersfield & Kern County. Licensed & insured, same-day when the route allows, text photos for a fast free quote. Call (661) 996-6950."
  path="/"
  schema={schema}
>
  <section class="hero">
    <div class="container">
      <div>
        <span class="eyebrow">Father–son crew · Bakersfield, CA</span>
        <h1>Bakersfield's most reliable <span class="accent">junk removal.</span></h1>
        <p class="lede">Residential and commercial hauling across Kern County. Straight talk, fair pricing — we show up when we say we will, and we leave the floor swept.</p>
        <ul class="trust">
          <li>Text a photo, get a fast quote</li>
          <li>Same-day when the route allows</li>
          <li>Licensed &amp; insured</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn-red btn-lg" href={`sms:${SITE.phoneTel}`}>Text photos — fast reply</a>
          <a class="btn btn-ghost btn-lg" href={`tel:${SITE.phoneTel}`}>Call {SITE.phone}</a>
        </div>
      </div>
      <div class="hero-photo">
        <img src="/assets/hero-team.webp" alt="T&M Hauling father and son crew with their truck in Bakersfield" width="900" height="1125" fetchpriority="high" />
        <div class="hero-badge">T&amp;M Hauling<small>Bakersfield &amp; Kern County</small></div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="center" style="margin-bottom:2.5rem">
        <span class="eyebrow">What we haul</span>
        <h2>Services built for real Bakersfield jobs</h2>
        <p class="lede">From a single couch to a full estate cleanout — one crew, one price, one visit.</p>
      </div>
      <div class="grid cols-3">
        {featured.map((s) => (
          <a class="card" href={`/services/${s.slug}.html`}>
            <h3>{name(s.h1)}</h3>
            <p>{s.lede.length > 130 ? s.lede.slice(0, 127).replace(/\s+\S*$/, '') + '…' : s.lede}</p>
            <span class="arrow">Learn more →</span>
          </a>
        ))}
      </div>
      <p class="center" style="margin-top:2rem"><a class="btn btn-ghost" href="/services.html">See all {services.length} services</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split" style="grid-template-columns: 1fr 1fr; align-items:center">
        <div>
          <span class="eyebrow">Free estimate</span>
          <h2>Get a price &amp; a crew date</h2>
          <p class="lede">One local crew, one inbox. Text a photo, fill out the form, or call — we reply fast and give you a straight number.</p>
          <ul class="trust" style="flex-direction:column">
            <li>No hidden fees — price confirmed before we lift</li>
            <li>Pay on site: card, cash, or payment link</li>
            <li>Optional $30 deposit holds your date (credited to your total)</li>
          </ul>
          <div class="btn-row"><a class="btn btn-ghost" href="/contact.html">Book with a $30 hold</a></div>
        </div>
        <div class="quote-box"><QuoteForm id="home-quote" /></div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container">
      <div class="center" style="margin-bottom:2.5rem">
        <span class="eyebrow">Visual proof</span>
        <h2>Before &amp; after</h2>
        <p class="lede">Real jobs from real Bakersfield customers — drag the slider.</p>
      </div>
      <div class="proof">
        <BeforeAfter before="/before-after/chrisbefore (1).jpg" after="/before-after/chrisafter (1).jpg" caption="Garage cleanout" alt="garage cleanout in Bakersfield" />
        <BeforeAfter before="/before-after/house1before (1).jpg" after="/before-after/house1after (1).jpg" caption="Whole-property cleanup" alt="property cleanup in Bakersfield" />
        <BeforeAfter before="/before-after/marcusbefore (1).jpg" after="/before-after/marcusafter (1).jpg" caption="Backyard debris removal" alt="backyard debris removal in Bakersfield" />
      </div>
      <p class="center" style="margin-top:2rem"><a class="btn btn-ghost" href="/gallery/index.html">See the full gallery</a></p>
    </div>
  </section>

  <section class="section light">
    <div class="container">
      <div class="center" style="margin-bottom:2.5rem">
        <span class="eyebrow">Our process</span>
        <h2>Simple. Efficient. Done.</h2>
        <p class="lede muted">Call or text a photo — we quote fast, show up on time, load everything, and leave your space clean.</p>
      </div>
      <div class="steps">
        <div class="step"><h3>Digital quote</h3><p>Send photos of your pile to {SITE.phone}. We reply with a straight answer and a time window that works.</p></div>
        <div class="step"><h3>Scheduled haul</h3><p>Pick a day. We confirm the price on site before we lift a thing — then load, sort, and haul in one visit.</p></div>
        <div class="step"><h3>Space reclaimed</h3><p>Trailer packed, area swept, stress gone. Pay on site — card, cash, or link.</p></div>
      </div>
      <div style="margin-top:3rem" class="center">
        <h3 style="font-size:1.4rem">What happens to your junk</h3>
        <p class="muted" style="max-width:44rem;margin:0 auto">We sort, donate what still has life, recycle where Kern County channels allow, and dispose of the rest responsibly — less landfill, more clarity for you.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="center" style="margin-bottom:2rem">
        <span class="eyebrow">Where we work</span>
        <h2>Serving every Bakersfield neighborhood</h2>
      </div>
      <div class="link-grid">
        {hoods.map((h) => <a href={`/neighborhoods/${h.slug}.html`}>{h.accent || h.slug}</a>)}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="container" style="max-width:820px">
      <div class="center" style="margin-bottom:1.5rem"><h2>Quick answers</h2></div>
      {faq.map((f) => <div class="qa"><h3>{f.q}</h3><p>{f.a}</p></div>)}
      <p class="center" style="margin-top:1.5rem"><a href="/faq.html" class="accent">More questions →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Leave the floor swept. Every time.</h2>
        <p>Ready when you are — text a photo and you'll have a number in minutes.</p>
        <div class="btn-row">
          <a class="btn btn-red btn-lg" href={`sms:${SITE.phoneTel}`}>Text photos</a>
          <a class="btn btn-ghost btn-lg" href={`tel:${SITE.phoneTel}`}>Call {SITE.phone}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
