---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
import services from '../data/services.json';
const name = (h1: string) => h1.replace(/ in Bakersfield$/, '');
const loadPrices = [
  ['Small load', 'Single items or small pickups', '$100–$175'],
  ['Medium load', 'Garage cleanouts or construction debris', '$275–$500'],
  ['Full truck load', 'Floor-to-ceiling loads', '$500–$750'],
];
const schema = [
  {
    '@type': 'ItemList',
    name: 'T&M Hauling services',
    itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/services/${s.slug}.html`, name: name(s.h1) })),
  },
];
---

<Base
  title="Junk Removal Services Bakersfield | T&M Hauling"
  description="Junk removal services in Bakersfield: storage units, estate cleanouts, garage cleanup, appliances, mattresses, scrap metal, yard waste and more. Free photo estimate."
  path="/services.html"
  schema={schema}
>
  <section class="page-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / Services</nav>
      <span class="eyebrow">Core capabilities</span>
      <h1>Junk removal services in <span class="accent">Bakersfield</span></h1>
      <p class="lede">Junk removal, cleanouts, appliance pickups, and on-site furniture moving in Bakersfield.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="grid cols-3">
        {services.map((s) => (
          <a class="card" href={`/services/${s.slug}.html`}>
            <h3>{name(s.h1)}</h3>
            <p>{s.lede.length > 150 ? s.lede.slice(0, 147).replace(/\s+\S*$/, '') + '…' : s.lede}</p>
            <span class="arrow">Details &amp; pricing →</span>
          </a>
        ))}
      </div>
      <section class="service-detail" aria-labelledby="typical-pricing">
        <h2 id="typical-pricing">Typical hauling prices</h2>
        <div class="grid cols-3">
          {loadPrices.map(([label, details, price]) => (
            <div class="card"><h3>{label}</h3><strong>{price}</strong><p>{details}</p></div>
          ))}
        </div>
        <p>These are typical ranges. Prices may vary with weight and distance. The crew confirms the price on site after seeing the job.</p>
        <p>Single appliance pickup typically runs <strong>$100–$175</strong>, depending on size, weight, and access. Multiple appliances get a bulk rate. <a href={`sms:${SITE.phoneTel}`}>Text us a photo for a fast, no-obligation estimate.</a></p>
      </section>
      <section class="service-detail" aria-labelledby="coverage">
        <h2 id="coverage">Bakersfield service area</h2>
        <div class="coverage-map">
          <iframe title="Map of Bakersfield and nearby communities" loading="lazy" src="https://maps.google.com/maps?q=35.37%2C-119.02&amp;z=10&amp;output=embed"></iframe>
          <div class="coverage-circle" aria-hidden="true"></div>
        </div>
        <p>The red circle shows our approximate Bakersfield coverage. We also serve nearby Kern County communities. <a href="/service-areas.html">See service areas</a> or <a href={`tel:${SITE.phoneTel}`}>call to confirm your address</a>.</p>
      </section>
      <div class="cta-band" style="margin-top:3.5rem">
        <h2>Not sure what category your job is?</h2>
        <p>Text a photo — we'll tell you what it takes and what it costs.</p>
        <div class="btn-row">
          <a class="btn btn-red btn-lg" href={`sms:${SITE.phoneTel}`}>Text photos</a>
          <a class="btn btn-ghost btn-lg" href="/contact.html">Free estimate form</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .service-detail { margin-top: 3.5rem; }
  .service-detail h2 { margin-bottom: 1rem; }
  .service-detail > p { margin-top: 1rem; }
  .coverage-map { position: relative; isolation: isolate; overflow: hidden; border-radius: 1rem; }
  .coverage-map iframe { display: block; width: 100%; height: clamp(19rem, 45vw, 27rem); border: 0; }
  .coverage-circle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(64%, 17rem);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border: 3px solid #c8212d;
    border-radius: 50%;
    background: rgb(200 33 45 / 8%);
    pointer-events: none;
  }
</style>
