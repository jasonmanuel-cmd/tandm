---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | T&M Hauling" description="That page could not be found." path="/404.html" noindex>
  <section class="section">
    <div class="container center">
      <span class="eyebrow">404</span>
      <h1>Nothing here — <span class="accent">but we can haul it.</span></h1>
      <p class="lede">The page you wanted moved or never existed.</p>
      <div class="btn-row" style="justify-content:center;margin-top:1.5rem">
        <a class="btn btn-red btn-lg" href="/">Home</a>
        <a class="btn btn-ghost btn-lg" href="/services.html">Services</a>
      </div>
    </div>
  </section>
</Base>
