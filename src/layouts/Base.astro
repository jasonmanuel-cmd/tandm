---
import '../styles/global.css';
import { SITE, NAV } from '../data/site';
import services from '../data/services.json';

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  schema?: object[];
  noindex?: boolean;
}
const { title, description, path, image = '/assets/hero-team.webp', schema = [], noindex = false } = Astro.props;
const canonical = `${SITE.url}${path}`;
const imageUrl = image.startsWith('http') ? image : `${SITE.url}${image}`;

const business: Record<string, unknown> = {
  '@type': 'LocalBusiness',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  description:
    'T&M Hauling is a local, family-owned junk removal and hauling business based in Bakersfield, CA. Residential cleanouts, commercial debris removal, and same-day hauling across Kern County.',
  url: SITE.url,
  telephone: SITE.phoneTel,
  email: SITE.email,
  image: `${SITE.url}/TM-L-2-scaled.png`,
  logo: `${SITE.url}/TM-L-Round-300x300.png`,
  priceRange: '$$',
  contactPoint: [SITE.phoneTel, SITE.phone2Tel].map((t) => ({
    '@type': 'ContactPoint',
    telephone: t,
    contactType: 'customer service',
    areaServed: 'US-CA',
    availableLanguage: ['en'],
  })),
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.city,
    addressRegion: SITE.region,
    postalCode: SITE.postalCode,
    addressCountry: 'US',
  },
  geo: { '@type': 'GeoCoordinates', ...SITE.geo },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: SITE.hours.days, opens: SITE.hours.opens, closes: SITE.hours.closes },
  ],
  areaServed: [
    { '@type': 'City', name: 'Bakersfield' },
    { '@type': 'AdministrativeArea', name: 'Kern County' },
  ],
  sameAs: [SITE.googleShare, ...SITE.social.map((s) => s.href)],
};
if (SITE.rating) {
  business.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: SITE.rating.value,
    reviewCount: SITE.rating.count,
    bestRating: 5,
  };
}
const graph = { '@context': 'https://schema.org', '@graph': [business, ...schema] };
---

<!doctype html>
<html lang="en">
  <head>
    {path === "/" && <meta name="google-site-verification" content="-AWQWaeIF4ctpthlbe9G2eCdqxEJjVn9EGRPUngo1m0" />}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="geo.region" content="US-CA" />
    <meta name="geo.placename" content="Bakersfield" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/png" href="/TM-L-Round-150x150.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <div class="topbar">
      <div class="container">
        <div class="links">
          <a href={`tel:${SITE.phoneTel}`}>📞 {SITE.phone}</a>
          <a href={`sms:${SITE.phoneTel}`}>💬 Text photos</a>
          <a class="hide-sm" href={`tel:${SITE.phone2Tel}`}>📞 {SITE.phone2}</a>
          <a class="hide-sm" href={`mailto:${SITE.email}`}>✉ Email</a>
        </div>
        <div class="links hide-sm">
          {SITE.social.slice(0, 4).map((s) => <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>)}
        </div>
      </div>
    </div>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/" aria-label="T&M Hauling home">
          <img src="/TM-L-Round-150x150.png" alt="" width="44" height="44" />
          <span>T&amp;M Hauling</span>
        </a>
        <button class="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="nav">Menu</button>
        <nav class="nav" id="nav" aria-label="Main">
          {NAV.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
          <a class="btn btn-red" href="/contact.html">Free estimate</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a class="brand" href="/"><img src="/TM-L-Round-150x150.png" alt="" width="44" height="44" /><span>T&amp;M Hauling</span></a>
            <p class="muted" style="margin-top:1rem">Father–son junk removal in Bakersfield and Kern County. Licensed &amp; insured. We leave the floor swept.</p>
            <p><a href={`tel:${SITE.phoneTel}`}>{SITE.phone}</a> · <a href={`tel:${SITE.phone2Tel}`}>{SITE.phone2}</a><br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
            <p class="muted" style="font-size:.85rem">Mon–Fri 9am–5pm · text anytime</p>
          </div>
          <div>
            <h4>Services</h4>
            <ul>
              {services.slice(0, 7).map((s) => <li><a href={`/services/${s.slug}.html`}>{s.h1.replace(/ in Bakersfield$/, '')}</a></li>)}
              <li><a href="/services.html">All services →</a></li>
            </ul>
          </div>
          <div>
            <h4>Company</h4>
            <ul>
              {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
              <li><a href="/contact.html">Contact &amp; booking</a></li>
              <li><a href="/privacy.html">Privacy</a></li>
              <li><a href="/terms.html">Terms</a></li>
            </ul>
          </div>
          <div>
            <h4>Follow</h4>
            <ul>
              {SITE.social.map((s) => <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}
              <li><a href={SITE.googleShare} target="_blank" rel="noopener noreferrer">Google Business Profile</a></li>
            </ul>
          </div>
        </div>
        <div class="legal">
          <span>© {new Date().getFullYear()} T&amp;M Hauling · Bakersfield, CA</span>
          <span>Serving Bakersfield &amp; Kern County</span>
        </div>
      </div>
    </footer>

    <div class="callbar">
      <a href={`tel:${SITE.phoneTel}`}>Call now</a>
      <a href={`sms:${SITE.phoneTel}`}>Text photos</a>
    </div>

    <script is:inline>
      const t = document.querySelector('.nav-toggle');
      const n = document.getElementById('nav');
      t?.addEventListener('click', () => {
        const open = n.classList.toggle('open');
        t.setAttribute('aria-expanded', String(open));
      });
    </script>
  </body>
</html>
